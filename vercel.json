{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/assets/.*", "dest": "/assets/$1" },
    { "src": "/.*\\.(js|css|json|wasm|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|webp|ply)$", "dest": "/$0" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
